<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Aero7</vendor><vendor_url>https://github.com/memegeko/aero7-programs-center</vendor_url>
  <action id="org.aero7.programscenter.manage-packages">
    <description>Install, remove, or update software</description>
    <message>Authentication is required to manage software on Aero7.</message>
    <defaults><allow_any>no</allow_any><allow_inactive>auth_admin</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/aero7-programs-center/aero7-programs-center-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">false</annotate>
  </action>
  <action id="org.aero7.programscenter.trusted-install">
    <description>Install a trusted Aero7 or Arch application</description>
    <message>Administrator approval is required before password-free trusted installs can be used.</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>no</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/aero7-programs-center/aero7-programs-center-trusted-installer</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">false</annotate>
  </action>
  <action id="org.aero7.programscenter.configure-passwordless">
    <description>Change password-free trusted installs for this account</description>
    <message>Administrator authentication is required to change this account's software permissions.</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/aero7-programs-center/aero7-programs-center-permissions</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">false</annotate>
  </action>
  <action id="org.aero7.programscenter.manage-sources">
    <description>Add or remove a signed external package repository</description>
    <message>Administrator authentication is required to change pacman repositories.</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/aero7-programs-center/aero7-programs-center-sources</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">false</annotate>
  </action>
</policyconfig>
