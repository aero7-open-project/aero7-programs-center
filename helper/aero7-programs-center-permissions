#!/usr/bin/bash
set -euo pipefail

[[ "${PKEXEC_UID:-}" =~ ^[0-9]+$ ]] || { echo "Polkit authorization is required." >&2; exit 77; }
[[ "$#" -eq 1 ]] || exit 64
[[ "$PKEXEC_UID" -ne 0 ]] || exit 77
account="$(/usr/bin/getent passwd "$PKEXEC_UID")" || exit 77
user="${account%%:*}"
[[ "$user" =~ ^[A-Za-z_][A-Za-z0-9_.-]*\$?$ ]] || { echo "Unsupported account name." >&2; exit 77; }
rule="/etc/polkit-1/rules.d/49-aero7-programs-center-${PKEXEC_UID}.rules"

case "$1" in
  enable)
    umask 022
    temporary="$(/usr/bin/mktemp /etc/polkit-1/rules.d/.aero7-programs-center.XXXXXXXX)" || exit 73
    trap '/usr/bin/rm -f -- "$temporary"' EXIT
    /usr/bin/printf 'polkit.addRule(function(action, subject) {\n  if (action.id == "org.aero7.programscenter.trusted-install" &&\n      subject.user == "%s" && subject.local && subject.active) {\n    return polkit.Result.YES;\n  }\n});\n' "$user" > "$temporary"
    /usr/bin/chmod 0644 "$temporary"
    /usr/bin/chown root:root "$temporary"
    /usr/bin/mv -f -- "$temporary" "$rule"
    trap - EXIT
    ;;
  disable)
    /usr/bin/rm -f -- "$rule"
    ;;
  *) echo "Unsupported setting." >&2; exit 64 ;;
esac
