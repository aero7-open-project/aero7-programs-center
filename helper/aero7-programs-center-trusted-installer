#!/usr/bin/bash
set -euo pipefail

# Password-free authorization is granted only for this executable. It accepts
# one package from the official Aero7/Arch repositories, then checks the entire
# dependency plan before letting pacman execute the transaction.
[[ "${PKEXEC_UID:-}" =~ ^[0-9]+$ ]] || { echo "Polkit authorization is required." >&2; exit 77; }
[[ "$#" -eq 2 ]] || { echo "Expected one repository and package." >&2; exit 64; }
repository="$1"
package="$2"
case "$repository" in aero7|core|extra|multilib) ;; *) echo "This source requires normal authentication." >&2; exit 77 ;; esac
[[ "$package" =~ ^[A-Za-z0-9@._+-]+$ ]] || { echo "Invalid package name." >&2; exit 64; }
[[ ! -e /var/lib/pacman/db.lck ]] || { echo "Another package transaction is in progress." >&2; exit 75; }

target="$repository/$package"
plan="$(LC_ALL=C /usr/bin/pacman --sync --needed --print --print-format '%r/%n' -- "$target")" || exit 65
[[ -n "$plan" ]] || exit 0
while IFS= read -r planned; do
  [[ "$planned" =~ ^(aero7|core|extra|multilib)/[A-Za-z0-9@._+-]+$ ]] || {
    echo "A dependency would come from outside the trusted Aero7/Arch repositories; normal authentication is required." >&2
    exit 77
  }
  metadata="$(LC_ALL=C /usr/bin/pacman --sync --info -- "$planned")" || exit 65
  if ! /usr/bin/awk -F: '/^(Conflicts With|Replaces)[[:space:]]*:/ {
    value=$2; gsub(/^[[:space:]]+|[[:space:]]+$/, "", value);
    if (value != "None") exit 1
  }' <<< "$metadata"; then
    echo "This install would replace or conflict with an existing package; normal authentication is required." >&2
    exit 77
  fi
done <<< "$plan"

exec /usr/bin/pacman --noconfirm --sync --needed -- "$target"
