pkgname=aero7-programs-center-git
pkgver=0.2.0.r0.g0000000
pkgrel=1
epoch=1
pkgdesc='Windows 7-inspired graphical software manager for Aero7 Linux (testing)'
arch=('x86_64')
url='https://github.com/memegeko/aero7-programs-center'
license=('MIT')
depends=('qt6-base' 'pacman' 'appstream' 'appstream-qt' 'archlinux-appstream-data' 'flatpak' 'polkit' 'python' 'gnupg')
makedepends=('cmake' 'ninja' 'git' 'pkgconf')
provides=('aero7-programs-center')
conflicts=('aero7-programs-center')
source=('git+https://github.com/memegeko/aero7-programs-center.git')
sha256sums=('SKIP')
pkgver(){
  cd aero7-programs-center
  local described
  if described="$(git describe --long --tags --match 'v[0-9]*' 2>/dev/null)"; then
    printf '%s\n' "$described" | sed 's/^v//;s/-/.r/;s/-/./'
  else
    printf '0.2.0.r%s.g%s\n' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
  fi
}
build(){ cmake -S aero7-programs-center -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr; cmake --build build; }
check(){ ctest --test-dir build --output-on-failure; }
package(){ DESTDIR="$pkgdir" cmake --install build; }
